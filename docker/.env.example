# PayFlow Environment Variables Example

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/payflow_db
SPRING_DATASOURCE_USERNAME=payflow_user
SPRING_DATASOURCE_PASSWORD=payflow_pass

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

